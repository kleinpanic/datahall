{
  "name": "datahall",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "An interactive web museum for database internals",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:gpu": "node scripts/gpu-smoke.mjs",
    "test": "pnpm run test:unit && pnpm run test:e2e"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vgpu/wgsl": "0.6.0",
    "@vgpu/wgsl-std": "0.6.0",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "vgpu": "^0.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@modelcontextprotocol/server@>=2.0.0 <2.3.0": "^2.3.0",
      "undici@>=8.0.0 <8.12.2": "^8.12.2",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9"
    }
  }
}

---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryFilter from '../components/GalleryFilter.astro';
import { exhibits } from '../lib/exhibits';
---

<BaseLayout title="Gallery" description="Every database exhibit in the datahall">
  <header class="mb-10">
    <p class="pill mb-4">Gallery</p>
    <h1 class="display-heading mb-3 text-4xl">Every exhibit on display</h1>
    <p class="max-w-2xl text-[var(--color-fg-muted)]">
      Interactive filter by paradigm, family, or free-text search. Each card links to a full exhibit
      page with diagrams, walk-throughs, and short code excerpts. Sort is by initial release year.
    </p>
  </header>

  <GalleryFilter exhibits={exhibits} />

  <div
    class="mt-12 border-t border-[var(--color-border)] pt-8 text-xs text-[var(--color-fg-muted)]"
  >
    <p>
      Tip: Use <kbd class="font-mono">⌘K</kbd> / <kbd class="font-mono">Ctrl+K</kbd> to focus the search.
      Filters update the URL for easy sharing.
    </p>
  </div>
</BaseLayout>

---
/**
 * GpuFlow -- WebGPU packet-flow layer for data-path diagrams (vgpu).
 *
 * https://vgpu.sh
 *
 * A slot wrapper: the diagram's server-rendered SVG stays mounted on top
 * (z-10) and remains the complete, accessible content. Beneath it (z-0) a
 * canvas fades in when the browser exposes WebGPU and the visitor has not
 * requested reduced motion: data packets stream left-to-right through the
 * stage columns, tinted per segment, with faintly pulsing gate lines at
 * stage boundaries. Without WebGPU or with reduced motion the canvas stays
 * invisible and the static diagram is the whole story.
 *
 * Mount contract (see docs/vgpu-visuals.md):
 *   data-gpu-flow, data-stages (stage/column count), data-seed, data-fps
 */
interface Props {
  /** Number of stages/columns the flow passes through. */
  stages: number;
  /** Deterministic seed so server and client scenes agree per diagram. */
  seed?: number;
  fps?: number;
}

const { stages, seed = 11, fps = 30 } = Astro.props;
---

<div
  class="dh-gpu-flow relative overflow-hidden rounded-lg border border-[var(--color-border)]"
  data-gpu-flow
  data-stages={stages}
  data-seed={seed}
  data-fps={fps}
>
  <canvas
    class="absolute inset-0 z-0 h-full w-full opacity-0 transition-opacity duration-700"
    aria-hidden="true"></canvas>
  <div class="relative z-10">
    <slot />
  </div>
</div>

<script>
  /**
   * Client boot for GpuFlow. Astro hoists this module once; it attaches to
   * every [data-gpu-flow] on the page. Mirrors the GpuScene boot contract.
   */
  type Mount = HTMLElement;

  function clampInt(v: string | undefined, def: number, min: number, max: number): number {
    const n = parseInt(v ?? String(def), 10);
    return Math.max(min, Math.min(max, isNaN(n) ? def : n));
  }

  const mounts = Array.from(document.querySelectorAll<Mount>('[data-gpu-flow]'));
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasWebGpu = typeof navigator !== 'undefined' && 'gpu' in navigator;

  if (mounts.length > 0 && !reduced && hasWebGpu) {
    (async () => {
      try {
        const vgpu = await import('vgpu');
        const { init, effect, draw, frameLoop, surface, clock } = vgpu;

        // Panel-dark backdrop with a faint grid and pulsing stage gates.
        const BG_WGSL = `
          struct Params { time: f32, stages: f32 }
          @group(0) @binding(0) var<uniform> params: Params;

          @fragment
          fn fs_main(@location(0) uv: vec2f) -> @location(0) vec4f {
            let d = distance(uv, vec2f(0.5));
            var col = mix(vec3f(0.043, 0.055, 0.075), vec3f(0.020, 0.026, 0.036), smoothstep(0.1, 0.9, d));
            let grid = step(0.9985, fract(uv.x * 36.0)) + step(0.9985, fract(uv.y * 10.0));
            col += vec3f(0.04, 0.07, 0.08) * grid * 0.30;
            let n = max(int(params.stages + 0.5), 1);
            for (var k: i32 = 1; k < n; k = k + 1) {
              let fx = f32(k) / f32(n);
              let g = smoothstep(0.004, 0.0, abs(uv.x - fx));
              let pulse = 0.6 + 0.4 * sin(params.time * 1.6 + f32(k) * 1.3);
              col += vec3f(0.0, 0.55, 0.50) * g * 0.10 * pulse;
            }
            return vec4f(col, 1.0);
          }
        `;

        function makeFlowWgsl(seed: number) {
          return `
            struct Params { time: f32, stages: f32 }
            @group(0) @binding(0) var<uniform> params: Params;

            fn hash(n: f32) -> f32 {
              return fract(sin(n * 12.9898 + ${seed}.0) * 43758.5453);
            }

            struct VOut {
              @builtin(position) pos: vec4f,
              @location(0) uv: vec2f,
              @location(1) color: vec3f,
              @location(2) alpha: f32,
            }

            @vertex
            fn vs_main(@builtin(vertex_index) vi: u32, @builtin(instance_index) ii: u32) -> VOut {
              var corners = array<vec2f, 6>(
                vec2f(-1.0, -1.0), vec2f(1.0, -1.0), vec2f(1.0, 1.0),
                vec2f(-1.0, -1.0), vec2f(1.0, 1.0), vec2f(-1.0, 1.0)
              );
              let i = f32(ii);
              let nStages = max(params.stages, 1.0);

              let speed = 0.05 + hash(i * 5.1) * 0.07;
              let x = fract(params.time * speed + hash(i * 1.7));
              let lane = (hash(i * 2.3) - 0.5);
              let y = 0.5 + lane * 0.44 + 0.02 * sin(params.time * 1.4 + i);
              let size = 0.007 + hash(i * 3.9) * 0.009;

              // Per-stage-segment palette (teal / violet / amber / rose).
              let seg = floor(x * nStages);
              let cpick = hash(seg * 13.7 + 3.1);
              var col = vec3f(0.17, 0.83, 0.75);
              if (cpick > 0.75) { col = vec3f(1.0, 0.70, 0.28); }
              else if (cpick > 0.5) { col = vec3f(0.49, 0.36, 1.0); }
              else if (cpick > 0.25) { col = vec3f(1.0, 0.36, 0.56); }

              // Fade at both ends; brighten while crossing a stage gate.
              var a = smoothstep(0.0, 0.05, x) * (1.0 - smoothstep(0.95, 1.0, x));
              let fx = fract(x * nStages);
              let gate = smoothstep(0.10, 0.0, min(fx, 1.0 - fx));
              a *= 0.55 + 0.45 * gate;

              var out: VOut;
              let half2 = corners[vi] * vec2f(size * 0.25, size);
              out.pos = vec4f(vec2f(x, y) * 2.0 - 1.0 + half2, 0.0, 1.0);
              out.uv = corners[vi];
              out.color = col;
              out.alpha = a;
              return out;
            }

            struct FIn {
              @location(0) uv: vec2f,
              @location(1) color: vec3f,
              @location(2) alpha: f32,
            }

            @fragment
            fn fs_main(in: FIn) -> @location(0) vec4f {
              let r = length(in.uv);
              let disk = 1.0 - smoothstep(0.70, 1.0, r);
              if (disk <= 0.0) { discard; }
              var col = in.color * (0.45 + 0.55 * (1.0 - r));
              return vec4f(col, disk * clamp(in.alpha, 0.0, 1.0));
            }
          `;
        }

        for (const el of mounts) {
          const canvas = el.querySelector('canvas');
          if (!canvas) continue;

          const stages = clampInt(el.dataset.stages, 3, 1, 12);
          const seed = clampInt(el.dataset.seed, 11, 0, 65535);
          const fps = clampInt(el.dataset.fps, 30, 8, 60);

          try {
            const gpu = await init();
            const surf = surface(gpu, canvas, { dpr: [1, 2] });

            const bg = effect(gpu, BG_WGSL, { set: { params: { time: 0, stages } } });
            const packets = draw(gpu, { shader: makeFlowWgsl(seed), instances: 140, vertices: 6 });

            const t = clock(gpu);
            const handle = frameLoop(
              gpu,
              (frame) => {
                const params = { time: t.time, stages };
                bg.set({ params });
                packets.set({ params });
                frame.pass({ target: surf }, (p) => {
                  p.draw(bg);
                  p.draw(packets);
                });
              },
              { fps },
            );

            el.dataset.gpuState = 'on';
            canvas.style.opacity = '1';

            // Clean up if the element is removed from the DOM (SPA / dev)
            const mo = new MutationObserver(() => {
              if (!el.isConnected) {
                handle.stop();
                mo.disconnect();
              }
            });
            mo.observe(document.documentElement, { childList: true, subtree: true });
          } catch {
            el.dataset.gpuState = 'error';
            // static SVG remains the diagram
          }
        }
      } catch {
        // module failed to load or init — static diagrams stay
      }
    })();
  }
</script>

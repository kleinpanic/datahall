---
/**
 * GpuFlow -- WebGPU packet-flow layer for data-path diagrams (vgpu).
 *
 * https://vgpu.sh
 *
 * A slot wrapper: the diagram's server-rendered SVG stays mounted on top
 * (z-10) and remains the complete, accessible content. Beneath it (z-0) a
 * canvas fades in when the shared mount controller (`lib/vgpu-runtime.ts`)
 * has booted the scene near the viewport and the first frame has verifiably
 * completed on the GPU: data packets stream left-to-right through the stage
 * columns, tinted per segment, with faintly pulsing gate lines at stage
 * boundaries. The scene is graded through the shared bloom chain
 * (see lib/vgpu-bloom.ts); one GPU context is shared by every mount.
 * Reduced-motion changes, device loss, and teardown are handled by the
 * controller — without WebGPU the canvas never becomes visible and the
 * static diagram is the whole story.
 *
 * Mount contract (see docs/vgpu-visuals.md):
 *   data-gpu-flow, data-stages (stage/column count), data-seed, data-fps
 */
interface Props {
  /** Number of stages/columns the flow passes through. */
  stages: number;
  /** Deterministic seed so server and client scenes agree per diagram. */
  seed?: number;
  fps?: number;
}

const { stages, seed = 11, fps = 30 } = Astro.props;
---

<div
  class="dh-gpu-flow relative overflow-hidden rounded-lg border border-[var(--color-border)]"
  data-gpu-flow
  data-stages={stages}
  data-seed={seed}
  data-fps={fps}
>
  <canvas
    class="absolute inset-0 z-0 h-full w-full opacity-0 transition-opacity duration-700"
    aria-hidden="true"></canvas>
  <div class="relative z-10">
    <slot />
  </div>
</div>

<script>
  /**
   * Client boot for GpuFlow. Astro hoists this module once; it attaches to
   * every [data-gpu-flow] on the page through the shared mount controller,
   * which owns GPU acquisition, viewport-deferred boot, first-frame
   * verification, reduced-motion changes, device loss, and teardown.
   */
  import { mountGpuScene } from '../../lib/vgpu-runtime';
  import { createBloomChain } from '../../lib/vgpu-bloom';
  import bgShader from '../../wgsl/gpu-flow-bg.wgsl';
  import packetsShader from '../../wgsl/gpu-flow-packets.wgsl';

  type Mount = HTMLElement;

  function clampInt(v: string | undefined, def: number, min: number, max: number): number {
    const n = parseInt(v ?? String(def), 10);
    return Math.max(min, Math.min(max, isNaN(n) ? def : n));
  }

  const mounts = Array.from(document.querySelectorAll<Mount>('[data-gpu-flow]'));
  for (const el of mounts) {
    const canvas = el.querySelector('canvas');
    if (!canvas) continue;

    const stages = clampInt(el.dataset.stages, 3, 1, 12);
    const seed = clampInt(el.dataset.seed, 11, 0, 65535);
    const fps = clampInt(el.dataset.fps, 30, 8, 60);

    mountGpuScene({
      el,
      canvas,
      fps,
      build: async ({ vgpu, gpu, surface }) => {
        const bg = vgpu.effect(gpu, bgShader, { set: { params: { time: 0, stages } } });
        const packets = vgpu.draw(gpu, {
          shader: packetsShader,
          instances: 140,
          vertices: 6,
        });
        const chain = createBloomChain(vgpu, gpu, surface.size);
        await Promise.all([
          bg.compile({ colors: ['rgba16float'] }),
          packets.compile({ colors: ['rgba16float'] }),
          chain.prewarm(surface.format),
        ]);

        let lastW = -1;
        let lastH = -1;
        return {
          render(frame, time) {
            const [sw, sh] = surface.size;
            if (sw !== lastW || sh !== lastH) {
              lastW = sw;
              lastH = sh;
              chain.resize(surface.size);
            }
            bg.set({ params: { time, stages } });
            packets.set({ params: { time, stages, seed } });
            frame.pass({ target: chain.scene }, (p) => {
              p.draw(bg);
              p.draw(packets);
            });
            chain.render(frame, surface, { strength: 0.55, time });
          },
          destroy() {
            chain.destroy();
          },
        };
      },
      onActive() {
        el.dataset.gpuState = 'on';
        canvas.style.opacity = '1';
      },
      onFallback(reason) {
        canvas.style.opacity = '0';
        el.dataset.gpuState =
          reason === 'error' ? 'error' : reason === 'device-lost' ? 'device-lost' : 'off';
      },
    });
  }
</script>

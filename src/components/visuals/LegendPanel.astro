---
/**
 * LegendPanel -- explains the color/layer taxonomy used across exhibits.
 * Categories are configurable through the visual payload; defaults match
 * the global CSS palette.
 */
import type { VisualLegend } from '../../lib/schema';

interface Props {
  visual: VisualLegend;
}

const { visual } = Astro.props;
const cats = visual.categories;
---

<aside class="legend-panel panel p-4" data-legend aria-label={visual.title}>
  <h3 class="display-heading mb-3 text-sm tracking-widest text-[var(--color-fg-muted)] uppercase">
    {visual.title}
  </h3>
  <p class="mb-3 text-xs text-[var(--color-fg-muted)]">{visual.description}</p>
  <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs sm:grid-cols-3">
    {
      cats.map((c) => (
        <li class="flex items-center gap-2" data-legend-key={c.key}>
          <span
            class="inline-block h-3 w-3 rounded-sm border"
            style={`background:${c.color}33;border-color:${c.color}`}
            aria-hidden="true"
          />
          <span class="font-mono text-[var(--color-fg)]">{c.label}</span>
        </li>
      ))
    }
  </ul>
</aside>

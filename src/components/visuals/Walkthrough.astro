            })()}
            <g data-wt="wt-ii-q-wired">
              <rect x={12} y={252} width={200} height={24} rx={4} fill="#10201c" stroke="#f5a623" />
              <text x={20} y={269} fill="#f5a623" font-size="10">
                fetch "wired" → [d1, d3]
              </text>
            </g>
            <g data-wt="wt-ii-q-lsm">
              <rect x={340} y={252} width={200} height={24} rx={4} fill="#10201c" stroke="#f5a623" />
              <text x={348} y={269} fill="#f5a623" font-size="10">

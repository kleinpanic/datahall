      >
      <button
        type="button"
        data-ctrl="prev"
        class="rounded border border-[var(--color-border)] px-2 py-1 hover:bg-white/5"
        >◀ step</button
      >
      <button
        type="button"
        data-ctrl="next"
        class="rounded border border-[var(--color-border)] px-2 py-1 hover:bg-white/5"
        >step ▶</button
      >
      <button
        type="button"
        data-ctrl="reset"
        class="rounded border border-[var(--color-border)] px-2 py-1 hover:bg-white/5"
        >↺ reset</button
      >
      <span class="font-mono text-[0.7rem] text-[var(--color-fg-muted)]" data-wt-counter></span>
    </div>
    <p class="font-mono text-[0.7rem] text-[var(--color-fg-muted)]" data-wt-note aria-live="polite">
    </p>
    <table
      class="w-full max-w-md text-left font-mono text-[0.7rem] text-[var(--color-fg-muted)]"
      aria-label="Final state summary"
    >
      <tbody>
        {
          trace.summary.map(([k, v]) => (
            <tr>
              <td class="pr-3 align-top text-[var(--color-fg)]">{k}</td>
              <td class="align-top">{v}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <details class="text-xs text-[var(--color-fg-muted)]">
      <summary class="cursor-pointer">All steps</summary>
      <ol class="mt-1 list-decimal space-y-1 pl-5" data-wt-steps>
        {
          trace.steps.map((s) => (
            <li>
              <span class="text-[var(--color-fg)]">{s.title}</span> — {s.note}
            </li>
          ))
        }
      </ol>
    </details>
    <p class="text-[0.7rem] text-[var(--color-fg-muted)]">{trace.intro}</p>
    {visual.caption && <p class="text-[0.7rem] text-[var(--color-fg-muted)]">{visual.caption}</p>}
  </div>
</div>

<script>
  /**
   * Walkthrough replay. The server rendered the final state; the client owns
   * the step cursor: cumulative reveals of data-wt elements, narration swap,
   * step-list highlight. Play is the only timed behavior; everything works
   * discretely for reduced-motion users.
   */
  interface WtStepJson {
    title: string;
    note: string;
    reveal: string[];
  }

  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-wt-panel]'));
  for (const panel of panels) {
    const svg = panel.querySelector<SVGSVGElement>('[data-wt-svg]');
    const stepsEl = panel.querySelector<HTMLOListElement>('[data-wt-steps]');
    const note = panel.querySelector<HTMLElement>('[data-wt-note]');
    const counter = panel.querySelector<HTMLElement>('[data-wt-counter]');
    const playBtn = panel.querySelector<HTMLButtonElement>('[data-ctrl="play"]');
    let trace: WtStepJson[] = [];
    try {
      trace = (JSON.parse(panel.dataset.trace ?? '[]') as { steps: WtStepJson[] }).steps ?? [];
    } catch {
      trace = [];
    }
    if (trace.length === 0 || !svg) continue;

    const revealedAt = new Map<string, number>();
    trace.forEach((s, i) => {
      for (const key of s.reveal) {
        const at = revealedAt.get(key);
        if (at === undefined || i < at) revealedAt.set(key, i);
      }
    });
    const wtEls = Array.from(svg.querySelectorAll<SVGElement>('[data-wt]'));
    const stepItems = stepsEl ? Array.from(stepsEl.querySelectorAll('li')) : [];

    let idx = trace.length - 1; // final state first (matches no-JS render)
    let playing = false;
    let timer: number | undefined;

    function apply(): void {
      for (const el of wtEls) {
        const key = el.getAttribute('data-wt') ?? '';
        const at = revealedAt.get(key);
        const visible = at !== undefined && at <= idx;
        el.style.opacity = visible ? '1' : '0';
      }
      const step = trace[idx];
      if (note) note.textContent = `Step ${idx + 1}/${trace.length} — ${step.title}: ${step.note}`;
      if (counter) counter.textContent = `${idx + 1} / ${trace.length}`;
      stepItems.forEach((li, i) => {
        li.style.fontWeight = i === idx ? '600' : '';
        li.style.color = i === idx ? 'var(--color-fg)' : '';
      });
      if (playBtn) {
        playBtn.textContent = playing ? '❚❚ pause' : '▶ play';
        playBtn.setAttribute('aria-pressed', String(playing));
      }
    }

    function stop(): void {
      playing = false;
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
      if (playBtn) {
        playBtn.textContent = '▶ play';
        playBtn.setAttribute('aria-pressed', 'false');
      }
    }

    panel.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest?.('[data-ctrl]');
      if (!btn) return;
      const kind = btn.getAttribute('data-ctrl');
      if (kind === 'play') {
        if (playing) {
          stop();
        } else {
          playing = true;
          if (idx >= trace.length - 1) idx = 0;
          apply();
          timer = window.setInterval(() => {
            if (idx >= trace.length - 1) {
              stop();
            } else {
              idx++;
            }
            apply();
          }, 1600);
        }
      } else if (kind === 'next') {
        stop();
        idx = Math.min(trace.length - 1, idx + 1);
      } else if (kind === 'prev') {
        stop();
        idx = Math.max(0, idx - 1);
      } else if (kind === 'reset') {
        stop();
        idx = 0;
      }
      apply();
    });

    apply();
  }
</script>

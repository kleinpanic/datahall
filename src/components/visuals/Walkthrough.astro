                    />
                    <text x={root.x + root.w + 12} y={root.y + 20} fill="#f5a623" font-size="10">
                      10 ≤ 12 &lt; 20 → middle
                    </text>
                  </g>
                  <g data-wt="wt-bt-path-l2">
                    <line
                      x1={root.x + 40}
                      y1={70}
                      x2={280}
                      y2={130}
                      stroke="#f5a623"
                      stroke-width="2"
                      marker-end="url(#wt-arrow-amber)"
                    />
                    <line
                      x1={root.x + 100}
                      y1={70}
                      x2={430}
                      y2={130}
                      stroke="#f5a623"
                      stroke-width="2"
                      marker-end="url(#wt-arrow-amber)"
                    />
                  </g>
                  {[0, 1, 2].map((i) => {
                    const bx = 30 + i * 130;
                    const names = ['L1', 'L2', 'L3'];
                    const keys = [
                      [2, 5, 8],
                      [10, 12, 15],
                      [20, 25, 30],
                    ][i];
                    return (
                      <g>
                        <rect
                          x={bx}
                          y={130}
                          width={110}
                          height={28}
                          rx={6}
                          fill="#161c25"
                          stroke={i === 1 ? '#f5a623' : '#3a4356'}
                        />
                        <text x={bx + 8} y={149} fill="#e6ebf4" font-size="11">
                          {names[i]} [{keys.join(', ')}]
                        </text>
                      </g>
                    );
                  })}
                  <g data-wt="wt-bt-found">
                    <rect
                      x={185}
                      y={170}
                      width={120}
                      height={26}
                      rx={6}
                      fill="#10201c"
                      stroke="#00ffe1"
                    />
                    <text x={193} y={188} fill="#00ffe1" font-size="11">
                      12 found in L2
                    </text>
                  </g>
                  <g data-wt="wt-bt-summary">
                    <rect
                      x={30}
                      y={220}
                      width={260}
                      height={26}
                      rx={6}
                      fill="#10201c"
                      stroke="#00ffe1"
                    />
                    <text x={38} y={238} fill="#00ffe1" font-size="11">
                      2 pages touched · 5 comparisons total
                    </text>
                  </g>
                </g>
              );
            })()}
          </g>
        )
      }

      {
        modeFamily === 'lsm' && (
          <g font-family="ui-monospace, monospace">
            {/* memtable */}
            <rect x={20} y={30} width={190} height={130} rx={8} fill="#11161d" stroke="#3a4356" />
            <text x={30} y={50} fill="#8b95a7" font-size="11">
              memtable (memory)
            </text>
            <g data-wt="wt-lsm-mem-c5">
              <rect x={30} y={60} width={80} height={22} rx={4} fill="#1a2130" stroke="#5cffb1" />
              <text x={38} y={75} fill="#e6ebf4" font-size="11">
                c = 5
              </text>
            </g>
            <g data-wt="wt-lsm-mem-c7">
              <rect x={118} y={60} width={80} height={22} rx={4} fill="#1a2130" stroke="#5cffb1" />
              <text x={126} y={75} fill="#e6ebf4" font-size="11">
                c = 7
              </text>
            </g>
            {visual.mode === 'lsm-compaction' && (
              <g data-wt="wt-lsm-mem-tomb">
                <rect
                  x={30}
                  y={92}
                  width={168}
                  height={22}
                  rx={4}
                  fill="#2a1219"
                  stroke="#ff5d8f"
                />
                <text x={38} y={107} fill="#ff5d8f" font-size="11">
                  c = ⊥ (tombstone)
                </text>
              </g>
            )}
            <g data-wt="wt-lsm-wal">
              <rect x={20} y={290} width={330} height={26} rx={6} fill="#10201c" stroke="#00ffe1" />
              <text x={28} y={308} fill="#00ffe1" font-size="11">
                WAL — every put/delete appended here before the memtable ack
              </text>
            </g>
            {/* runs */}
            {lsm.runsInitial.map((r, i) => (
              <g>
                <rect
                  x={240}
                  y={30 + i * 66}
                  width={190}
                  height={56}
                  rx={8}
                  fill="#11161d"
                  stroke="#3a4356"
                />
                <text x={250} y={50 + i * 66} fill="#8b95a7" font-size="10">
                  {r.label}
                </text>
                {r.items.map((it, j) => (
                  <rect
                    x={250 + j * 85}
                    y={58 + i * 66}
                    width={78}
                    height={20}
                    rx={4}
                    fill="#1a2130"
                    stroke="#3a4356"
                  />
                ))}
                {r.items.map((it, j) => (
                  <text x={256 + j * 85} y={72 + i * 66} fill="#e6ebf4" font-size="10">
                    {it}
                  </text>
                ))}
              </g>
            ))}
            <g data-wt="wt-lsm-r3">
              <rect
                x={240}
                y={162}
                width={190}
                height={40}
                rx={8}
                fill="#11161d"
                stroke="#f5a623"
              />
              <text x={250} y={178} fill="#f5a623" font-size="10">
                R3 (L0, newest — flushed)
              </text>
              <rect x={250} y={182} width={78} height={16} rx={4} fill="#1a2130" stroke="#3a4356" />
              <text x={256} y={194} fill="#e6ebf4" font-size="10">
                c = 7
              </text>
            </g>
            {visual.mode === 'lsm-compaction' && (
              <g data-wt="wt-lsm-r4">
                <rect
                  x={240}
                  y={208}
                  width={190}
                  height={40}
                  rx={8}
                  fill="#11161d"
                  stroke="#ff5d8f"
                />
                <text x={250} y={224} fill="#ff5d8f" font-size="10">
                  R4 (L0 — tombstone)
                </text>
                <rect
                  x={250}
                  y={228}
                  width={110}
                  height={16}
                  rx={4}
                  fill="#1a2130"
                  stroke="#3a4356"
                />
                <text x={256} y={240} fill="#e6ebf4" font-size="10">
                  c = ⊥
                </text>
              </g>
            )}
            {/* L1 before + after */}
            <rect x={470} y={30} width={220} height={56} rx={8} fill="#11161d" stroke="#3a4356" />
            <text x={480} y={50} fill="#8b95a7" font-size="10">
              L1 (merged run)
            </text>
            <text
              x={480}
              y={72}
              fill="#e6ebf4"
              font-size="11"
            >{`{ ${lsm.l1Initial.join(', ')} }`}</text>
            {visual.mode === 'lsm-compaction' && (
              <g data-wt="wt-lsm-l1-after">
                <rect
                  x={470}
                  y={100}
                  width={230}
                  height={78}
                  rx={8}
                  fill="#10201c"
                  stroke="#00ffe1"
                />
                <text x={480} y={120} fill="#00ffe1" font-size="10">
                  L1 after compaction
                </text>
                <text
                  x={480}
                  y={142}
                  fill="#e6ebf4"
                  font-size="11"
                >{`{ ${lsm.l1After.join(', ')} }`}</text>
                <text x={480} y={164} fill="#8b95a7" font-size="9">
                  c dropped: shadowed by tombstone, tombstone expired
                </text>
              </g>

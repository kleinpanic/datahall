            {/* lookup annotations */}
            <g data-wt="wt-lsm-lk1">
              <rect x={20} y={170} width={200} height={24} rx={6} fill="#10201c" stroke="#00ffe1" />
              <text x={28} y={187} fill="#00ffe1" font-size="10">
                lookup(c): memtable → 7 (1 struct)
              </text>
            </g>
            <g data-wt="wt-lsm-lk2">
              <rect x={20} y={200} width={210} height={24} rx={6} fill="#10201c" stroke="#00ffe1" />
              <text x={28} y={217} fill="#00ffe1" font-size="10">
                lookup(d): miss → miss → R2 → 4
              </text>
            </g>
            {visual.mode === 'lsm-compaction' && (
              <g data-wt="wt-lsm-lk3">
                <rect
                  x={20}
                  y={230}
                  width={210}
                  height={24}
                  rx={6}
                  fill="#2a1219"
                  stroke="#ff5d8f"
                />
                <text x={28} y={247} fill="#ff5d8f" font-size="10">
                  lookup(c): R4 tombstone → not found
                </text>
              </g>
            )}
            {visual.mode === 'lsm-overwrite' && (
              <g data-wt="wt-lsm-lk4">
                <rect
                  x={20}
                  y={230}
                  width={210}
                  height={24}
                  rx={6}
                  fill="#10201c"
                  stroke="#00ffe1"
                />
                <text x={28} y={247} fill="#00ffe1" font-size="10">
                  lookup(a): 4 structs → R1 → 1
                </text>

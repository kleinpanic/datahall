                    </text>
                    <text x={395} y={170} fill="#8b95a7" font-size="10">
                      leaf split — order preserved
                    </text>
                  </g>
                );
              })()}
            </g>
            <g data-wt="wt-bt-root-after">
              {(() => {
                const root = nodeBox(420, 30, [6, 10, 20], 170);
                return (
                  <g>
                    <rect
                      x={root.x}
                      y={root.y}

                    </text>
                    <text x={root.x + root.w + 10} y={root.y + 20} fill="#f5a623" font-size="10">
                      ← 6 copied up
                    </text>
                    <line
                      x1={root.x + 30}
                      y1={60}
                      x2={445}
                      y2={118}
                      stroke="#3a4356"
                      marker-end="url(#wt-arrow)"
                    />
                    <line
                      x1={root.x + 80}
                      y1={60}
                      x2={565}
                      y2={118}
                      stroke="#3a4356"
                      marker-end="url(#wt-arrow)"
                    />
                    <line
                      x1={root.x + 130}
                      y1={60}
                      x2={655}
                      y2={118}
                      stroke="#3a4356"
                      marker-end="url(#wt-arrow)"
                    />
                  </g>
                );
              })()}
            </g>
            <g data-wt="wt-bt-summary">
              <rect
                x={400}
                y={200}
                width={280}
                height={26}
                rx={6}
                fill="#10201c"
                stroke="#00ffe1"
              />
              <text x={408} y={218} fill="#00ffe1" font-size="11">
                height unchanged · 3 nodes rewritten · data stays in leaves
              </text>
            </g>
          </g>
        )
      }

      {
        modeFamily === 'btree' && visual.mode === 'btree-search' && (
          <g font-family="ui-monospace, monospace">
            {(() => {
              const root = nodeBox(105, 40, [10, 20], 130);
              return (
                <g>
                  <rect
                    x={root.x}
                    y={root.y}
                    width={root.w}
                    height={30}
                    rx={6}
                    fill="#161c25"
                    stroke="#7c5cff"
                  />
                  <text x={root.x + 8} y={root.y + 20} fill="#e6ebf4" font-size="12">
                    root [{root.keys.join(', ')}]
                  </text>
                  <g data-wt="wt-bt-cmp-root">
                    <circle
                      cx={root.x + root.w / 2}
                      cy={root.y + 15}
                      r={26}
                      fill="none"
                      stroke="#f5a623"

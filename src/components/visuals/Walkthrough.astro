                          {n.id} [{n.keys.join(', ')}]
                        </text>
                        {n.id === 'l1' && (
                          <g data-wt="wt-bt-l1-before">
                            <circle
                              cx={bx + 55}
                              cy={by + 14}
                              r={22}
                              fill="none"
                              stroke="#f5a623"
                              stroke-width="1.5"
                            />
                          </g>
                        )}
                      </g>
                    );
                  })}
                  <g data-wt="wt-bt-l1-insert">
                    <rect
                      x={30}
                      y={165}
                      width={200}
                      height={28}
                      rx={6}
                      fill="#1a2130"
                      stroke="#ff5d8f"
                    />

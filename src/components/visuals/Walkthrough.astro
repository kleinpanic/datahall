                    <text x={n1.x + 8} y={n1.y + 19} fill="#e6ebf4" font-size="11">
                      L1a [{n1.keys.join(', ')}]
                    </text>
                    <rect
                      x={n2.x}
                      y={n2.y}
                      width={n2.w}
                      height={28}
                      rx={6}
                      fill="#1a2130"
                      stroke="#00ffe1"
                    />
                    <text x={n2.x + 8} y={n2.y + 19} fill="#e6ebf4" font-size="11">

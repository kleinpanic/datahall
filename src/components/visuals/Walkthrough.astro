                          x2={bx + 55}
                          y2={by}
                          stroke="#3a4356"
                          marker-end="url(#wt-arrow)"
                        />
                        <rect
                          x={bx}
                          y={by}
                          width={110}
                          height={28}
                          rx={6}
                          fill="#161c25"
                          stroke={n.id === 'l1' ? '#ff5d8f' : '#3a4356'}

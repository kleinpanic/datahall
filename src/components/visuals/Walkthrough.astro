                      overflow: 4 keys &gt; max 3 → split
                    </text>
                  </g>
                </g>
              );
            })()}
            {/* after tree */}
            <g data-wt="wt-bt-split">
              {(() => {
                const n1 = nodeBox(395, 120, [2, 5], 100);
                const n2 = nodeBox(515, 120, [6, 8], 100);
                return (
                  <g>
                    <rect

---
/**
 * Walkthrough -- stepwise, narrated algorithm walkthrough (SVG + controls).
 *
 * One component, five method families, driven entirely by the deterministic
 * traces in src/lib/walkthroughs/:
 *   btree-split / btree-search  — B+ tree routing, leaf overflow, separator copy
 *   lsm-compaction / lsm-overwrite — memtable, immutable runs, tombstones, merge
 *   mvcc-commit                 — version visibility, WAL commit boundary, recovery
 *   graph-bfs                   — FIFO frontier, direction, shortest-path property
 *   columnar-scan               — column pruning, granule skipping, block predicates
 *
 * Rendering contract:
 *  - The server renders the FINAL state (every reveal element visible) plus the
 *    full step list and the state summary, so no-JS visitors get the complete
 *    explanation.
 *  - The client replays the same trace: elements tagged data-wt appear as their
 *    step is reached; play/pause/step/reset work discretely, so reduced-motion
 *    visitors get the full walkthrough without continuous animation.
 *  - Algorithmic state lives only in the trace; the SVG never invents results.
 */
import type { VisualWalkthrough } from '../../lib/schema';
import { btreeTrace, btreeRenderModel } from '../../lib/walkthroughs/btree';
import { lsmTrace, lsmRenderModel } from '../../lib/walkthroughs/lsm';
import { mvccTrace } from '../../lib/walkthroughs/mvcc';
import {
  graphBfsTrace,
  GRAPH_NODES,
  GRAPH_EDGES,
  type BfsTarget,
} from '../../lib/walkthroughs/graph-bfs';
import {
  columnarTrace,
  columnarModel,
  type ColumnarVariant,
} from '../../lib/walkthroughs/columnar';
import {
  bloomTrace,
  bloomState,
  bloomBits,
  findFalsePositive,
  BLOOM_BITS,
  BLOOM_K,
} from '../../lib/walkthroughs/bloom';
import {
  skipListTrace,
  skipRenderModel,
  SKIP_KEYS as SKIP_KEYS_ORDER,
} from '../../lib/walkthroughs/skiplist';
import { invertedTrace, II_TERMS, II_DOCS } from '../../lib/walkthroughs/inverted';
import type { WtTrace } from '../../lib/walkthroughs/types';

interface Props {
  visual: VisualWalkthrough;
}

const { visual } = Astro.props;
const alt = visual.variant === 'alt';

const trace: WtTrace = (() => {
  switch (visual.mode) {
    case 'btree-split':
      return btreeTrace('insert-split');
    case 'btree-search':
      return btreeTrace('search');
    case 'lsm-compaction':
      return lsmTrace('delete');
    case 'lsm-overwrite':
      return lsmTrace('overwrite');
    case 'mvcc-commit':
      return mvccTrace(alt ? 'crash-after-commit' : 'crash-before-commit');
    case 'graph-bfs':
      return graphBfsTrace((alt ? 'E' : 'F') as BfsTarget);
    case 'columnar-scan':
      return columnarTrace((alt ? 'full-scan' : 'range-filter') as ColumnarVariant);
    case 'bloom-filter':
      return bloomTrace(alt ? 'insert-only' : 'membership');
    case 'skiplist-memtable':
      return skipListTrace(alt ? 'redis' : 'lsm');
    case 'inverted-index':
      return invertedTrace(alt ? ['merge', 'lsm'] : ['wired', 'lsm']);
  }
})();

const fp = findFalsePositive();

const SKIP_X = (k: number) => 100 + SKIP_KEYS_ORDER.indexOf(k) * 100;

const modeFamily = visual.mode.startsWith('bloom')
  ? 'bloom'
  : visual.mode.startsWith('inverted')
    ? 'inverted'
    : visual.mode.startsWith('skiplist')
      ? 'skiplist'
    : visual.mode.startsWith('btree') || visual.mode === 'btree-search'
      ? 'btree'
      : visual.mode.startsWith('lsm')
        ? 'lsm'
        : visual.mode.startsWith('mvcc')
          ? 'mvcc'
          : visual.mode.startsWith('graph')
            ? 'graph'
            : 'columnar';

const W = 720;
const H = 380;

/* ---------------- btree render data ---------------- */
const bt = btreeRenderModel();
const btBefore = bt.before;
const nodeBox = (x: number, y: number, keys: number[], w = 150) => ({ x, y, keys, w });

/* ---------------- lsm render data ---------------- */
const lsm = lsmRenderModel();

/* ---------------- columnar render data ---------------- */
const col = columnarModel(alt ? 'full-scan' : 'range-filter');
const colSkipped = alt ? 0 : 5;
const colLoaded = col.granules - colSkipped;
const colRowPass = col.passingRows;

const toPx = (nx: number, ny: number, w = W, h = H) => ({ x: nx * w, y: ny * h });
---

<style>
  /* Chromium keeps closed-<details> children at computed display: list-item
     (content-visibility hiding), which gives their boxes real layout rects —
     the step list would ghost into overlap checks and page flow. Force real
     display: none until the reader opens it. */
  details:not([open]) > *:not(summary) {
    display: none;
  }
</style>

<div class="dh-walkthrough" data-wt-panel data-trace={JSON.stringify(trace)}>
  <div class="overflow-hidden rounded-lg border border-[var(--color-border)] bg-[#0a0e13] p-2">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label={`${visual.title} — ${visual.description}`}
      class="h-auto w-full"
      data-wt-svg
    >
      <defs>
        <marker
          id="wt-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#8b95a7"></path>
        </marker>
        <marker
          id="wt-arrow-amber"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#f5a623"></path>
        </marker>
      </defs>

      {
        modeFamily === 'btree' && visual.mode === 'btree-split' && (
          <g font-family="ui-monospace, monospace">
            <text x={20} y={18} fill="#8b95a7" font-size="11">
              before
            </text>
            <text x={400} y={18} fill="#8b95a7" font-size="11">
              after
            </text>
            {/* before tree */}
            {(() => {
              const root = nodeBox(105, 30, btBefore[0].keys, 130);
              return (
                <g>
                  <rect
                    x={root.x}
                    y={root.y}
                    width={root.w}
                    height={30}
                    rx={6}
                    fill="#161c25"
                    stroke="#7c5cff"
                  />
                  <text x={root.x + 8} y={root.y + 20} fill="#e6ebf4" font-size="12">
                    root [{root.keys.join(', ')}]
                  </text>
                  <g data-wt="wt-bt-cmp-root">
                    <circle
                      cx={root.x + root.w / 2}
                      cy={root.y + 15}
                      r={26}
                      fill="none"
                      stroke="#f5a623"
                      stroke-width="1.5"
                    />
                    <text x={root.x + root.w + 12} y={root.y + 20} fill="#f5a623" font-size="10">
                      6 &lt; 10 → left
                    </text>
                  </g>
                  {btBefore.slice(1).map((n, i) => {
                    const bx = 30 + i * 115;
                    const by = 120;
                    return (
                      <g>
                        <line
                          x1={root.x + root.w / 2}

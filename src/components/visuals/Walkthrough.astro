              <g data-wt="wt-lsm-summary">
                <rect
                  x={20}
                  y={262}
                  width={430}
                  height={22}
                  rx={6}
                  fill="#10201c"
                  stroke="#00ffe1"
                />
                <text x={28} y={278} fill="#00ffe1" font-size="10">
                  compaction traded write amplification for read speed — one version per key remains
                </text>
              </g>
            )}
          </g>
        )
      }

      {
        modeFamily === 'mvcc' && (
          <g font-family="ui-monospace, monospace">
            {/* version chain */}
            <rect x={20} y={40} width={220} height={44} rx={8} fill="#161c25" stroke="#7c5cff" />
            <text x={30} y={60} fill="#e6ebf4" font-size="11">
              v1: balance = 100 (xmin = 10)
            </text>
            <text x={30} y={76} fill="#8b95a7" font-size="9">
              visible to snapshots before A
            </text>
            <g data-wt="wt-mv-v2">
              <rect x={20} y={110} width={220} height={44} rx={8} fill="#1a2130" stroke="#f5a623" />
              <text x={30} y={130} fill="#e6ebf4" font-size="11">
                v2: balance = 250 (xmin = 100)
              </text>
              <text x={30} y={146} fill="#8b95a7" font-size="9">
                written by tx A — visibility depends on commit
              </text>
              <line
                x1={130}
                y1={84}
                x2={130}
                y2={108}
                stroke="#8b95a7"
                marker-end="url(#wt-arrow)"
              />
            </g>
            {/* readers */}
            <g data-wt="wt-mv-readerB">
              <rect x={280} y={40} width={230} height={30} rx={6} fill="#10201c" stroke="#00ffe1" />
              <text x={288} y={60} fill="#00ffe1" font-size="11">
                reader B (old snapshot) sees 100
              </text>
            </g>
            {visual.variant === 'alt' && (
              <g data-wt="wt-mv-commit">
                <rect

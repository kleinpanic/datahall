---
/**
 * VisualModuleRenderer -- the single entry point used by [slug].astro to mount
 * any visual on an exhibit page. Each kind routes to a registered component;
 * unknown kinds render a clear placeholder so the page never crashes.
 */
import type { Visual, VisualDiagram } from '../../lib/schema';
import { getVisualRenderer } from '../../lib/visuals';
import { getLegacyDiagramFactory } from '../../lib/visuals-legacy';

interface Props {
  visual: Visual;
  /** When true, the renderer is told that it is being rendered inside a `dev` context. */
  dev?: boolean;
}

const { visual, dev = import.meta.env.DEV } = Astro.props;
const Renderer = getVisualRenderer(visual.kind);

// `kind: 'diagram'` is special-cased: it dispatches by the legacy `component`
// field, so the renderer is null but the kind is still registered.
const legacyDiagram: VisualDiagram | null = visual.kind === 'diagram' ? visual : null;
const LegacyComponent = legacyDiagram ? getLegacyDiagramFactory(legacyDiagram.component) : null;
const legacyHasMatch = LegacyComponent !== null;

// A visual is "unknown" if it has neither a registered renderer nor a
// resolvable legacy diagram.
const isUnknown = !Renderer && !legacyHasMatch;
---

<figure class="panel my-6 p-4" data-visual-kind={visual.kind} data-visual-title={visual.title}>
  <figcaption class="mb-3 flex flex-wrap items-baseline justify-between gap-3">
    <span class="font-mono text-xs tracking-widest text-[var(--color-fg-muted)] uppercase">
      <span
        class="mr-2 rounded bg-[var(--color-bg-card)] px-1.5 py-0.5 text-[0.65rem] text-[var(--color-accent)]"
        >{visual.kind}</span
      >
      {visual.title}
    </span>
    {
      visual.kind !== 'legend' && (
        <span class="font-mono text-[0.65rem] text-[var(--color-fg-muted)]">
          click nodes for description
        </span>
      )
    }
  </figcaption>

  {
    isUnknown && (
      <div
        class="border border-dashed border-[var(--color-border)] p-6 text-sm text-[var(--color-fg-muted)]"
        role="alert"
      >
        <strong class="block font-mono text-[var(--color-warn)]">
          Unknown visual kind: <code>{visual.kind}</code>
        </strong>
        <span class="mt-2 block">{visual.description}</span>
        {dev && (
          <span class="mt-2 block font-mono text-xs">
            This is shown in development builds only.
          </span>
        )}
      </div>
    )
  }

  {!isUnknown && visual.kind === 'diagram' && LegacyComponent && <LegacyComponent />}

  {!isUnknown && visual.kind !== 'diagram' && Renderer && <Renderer visual={visual} />}

  {
    visual.kind !== 'legend' &&
      visual.kind !== 'family-map' &&
      'caption' in visual &&
      (visual as { caption?: string }).caption && (
        <p class="mt-3 text-xs text-[var(--color-fg-muted)] italic">
          <span class="font-mono text-[var(--color-fg-muted)] not-italic">[caption] </span>
          {(visual as { caption?: string }).caption}
        </p>
      )
  }
  {
    visual.kind !== 'legend' &&
      visual.kind !== 'family-map' &&
      'description' in visual &&
      (visual as { description?: string }).description && (
        <p class="mt-1 text-xs text-[var(--color-fg-muted)]">
          {(visual as { description?: string }).description}
        </p>
      )
  }
</figure>

<script>
  document.querySelectorAll('[data-visual-kind] [data-node-title]').forEach((el) => {
    el.addEventListener('click', (event) => {
      const target = event.currentTarget as HTMLElement;
      const title = target.getAttribute('data-node-title');
      if (!title) return;
      const parent = target.closest('[data-visual-kind]') as HTMLElement | null;
      if (!parent) return;
      let hint = parent.querySelector<HTMLElement>('[data-visual-hint]');
      if (!hint) {
        hint = document.createElement('div');
        hint.setAttribute('data-visual-hint', '');
        hint.className =
          'mt-2 rounded border border-[var(--color-border)] bg-[var(--color-bg-card)] px-3 py-2 font-mono text-xs text-[var(--color-fg-muted)]';
        parent.appendChild(hint);
      }
      hint.textContent = title;
    });
  });
</script>

<style>
  [data-visual-kind] [data-node-title] {
    cursor: pointer;
  }
  [data-visual-kind] [data-node-title]:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-visual-kind] * {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>

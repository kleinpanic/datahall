---
/**
 * QueryPlan -- EXPLAIN-style plan waterfall.
 * Steps render as a numbered list with cost bars relative to the most
 * expensive step; row estimates are shown when present. No client JavaScript.
 */
import type { VisualQueryPlan } from '../../lib/schema';

interface Props {
  visual: VisualQueryPlan;
}
const { visual } = Astro.props;

const steps = visual.steps ?? [];
const costs = steps.map((s) => s.cost ?? 0);
const maxCost = Math.max(...costs, 0);
const totalCost = costs.reduce((a, b) => a + b, 0);
const hasAnyCost = steps.some((s) => s.cost !== undefined);
const maxIdx = costs.indexOf(maxCost);

const fmt = (n: number): string =>
  Math.abs(n) >= 1_000_000
    ? `${(n / 1_000_000).toFixed(1)}M`
    : Math.abs(n) >= 1000
      ? `${(n / 1000).toFixed(1)}k`
      : `${Math.round(n * 10) / 10}`;
---

<div>
  <p class="mb-3 text-xs text-[var(--color-fg-muted)]">{visual.description}</p>
  {
    steps.length > 0 && (
      <ol class="space-y-2">
        {steps.map((s, i) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded border border-[var(--color-border)] bg-[var(--color-bg-elevated)] font-mono text-[10px] text-[var(--color-fg-muted)]">
              {i + 1}
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-0.5">
                <span class="min-w-0 font-mono text-xs break-words text-[var(--color-fg)]">
                  {s.step}
                </span>
                <span class="shrink-0 font-mono text-[10px] text-[var(--color-fg-muted)]">
                  {[
                    s.rows !== undefined ? `${fmt(s.rows)} rows` : null,
                    s.cost !== undefined ? `cost ${fmt(s.cost)}` : null,
                  ]
                    .filter(Boolean)
                    .join(' · ')}
                </span>
              </div>
              {s.cost !== undefined && maxCost > 0 && (
                <div class="mt-1 h-1.5 overflow-hidden rounded bg-[var(--color-bg-card)]">
                  <div
                    class="h-1.5 rounded"
                    style={`width:${Math.max(2, ((s.cost ?? 0) / maxCost) * 100)}%;background:${i === maxIdx ? 'var(--color-accent)' : 'var(--color-accent-dim)'}`}
                  />
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    )
  }
  {
    steps.length === 0 && (
      <p class="font-mono text-xs text-[var(--color-fg-muted)]">no plan steps provided</p>
    )
  }
  {
    hasAnyCost && totalCost > 0 && (
      <div class="mt-3 border-t border-[var(--color-border)] pt-2 text-right font-mono text-[10px] text-[var(--color-fg-muted)]">
        total est. cost {fmt(totalCost)}
      </div>
    )
  }
</div>
